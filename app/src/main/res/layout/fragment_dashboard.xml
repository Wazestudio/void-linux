<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOID-LINUX  /  KALI ROOTLESS"
            android:textColor="@color/void_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kali Linux"
            android:textColor="@color/void_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Terminal Linux rootless pour Android"
            android:textColor="@color/void_text_dim"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/VoidCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ÉTAT DE L'ENVIRONNEMENT"
                    android:textColor="@color/void_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/linuxStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="VÉRIFICATION…"
                    android:textColor="@color/void_warning"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/rootfsProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/void_accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/bootstrapMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/void_text_dim"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/architectureStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/void_text_dim"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PRoot · espace utilisateur Linux · noyau Android partagé"
                    android:textColor="@color/void_text_dim"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="ACCÈS RAPIDE"
            android:textColor="@color/void_text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openTerminalButton"
            style="@style/VoidButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="start|center_vertical"
            android:minHeight="58dp"
            android:text="Ouvrir le terminal"
            android:textSize="15sp"
            app:icon="@drawable/ic_nav_terminal"
            app:iconGravity="textStart"
            app:iconPadding="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openToolsButton"
            style="@style/VoidButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:minHeight="54dp"
            android:text="Système et paquets"
            android:textSize="14sp"
            app:icon="@drawable/ic_nav_linux"
            app:iconGravity="textStart"
            app:iconPadding="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openSecurityButton"
                style="@style/VoidButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Sécurité"
                android:textSize="12sp"
                app:icon="@drawable/ic_nav_security"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openTorButton"
                style="@style/VoidButton.Outlined"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Tor / Orbot"
                android:textSize="12sp"
                app:icon="@drawable/ic_nav_network"
                app:iconGravity="textStart"
                app:iconPadding="6dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Les outils réseau nécessitent une autorisation explicite."
            android:textColor="@color/void_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
