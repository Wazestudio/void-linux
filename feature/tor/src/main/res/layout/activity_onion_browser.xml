<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/void_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_s"
        android:background="@color/void_surface">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Retour" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@color/void_surface_variant"
            android:hint="https://… ou xxx.onion"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:paddingHorizontal="@dimen/space_s"
            android:singleLine="true"
            android:textColor="@color/void_text"
            android:textColorHint="@color/void_text_dim"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/toggleJsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_xs"
            android:background="?android:attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="JavaScript" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progressTint="@color/void_accent" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/void_background" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/directoryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="Annuaire .onion"
            app:backgroundTint="@color/void_accent"
            app:tint="@color/void_background" />
    </FrameLayout>
</LinearLayout>