<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tor_title"
            android:textColor="@color/void_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_m"
            android:background="@color/void_divider" />

        <com.google.android.material.card.MaterialCardView
            style="@style/VoidCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_m">

                <TextView
                    android:id="@+id/torStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tor_stopped"
                    style="@style/VoidText.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/installOrbot"
                    style="@style/VoidButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/tor_install_orbot"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startTor"
                    style="@style/VoidButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/tor_enable" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirmTor"
                    style="@style/VoidButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="J'ai activé Tor dans Orbot"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/stopTor"
                    style="@style/VoidButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/tor_disable" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openBrowser"
            style="@style/VoidButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/tor_browse_onion" />

    </LinearLayout>
</ScrollView>